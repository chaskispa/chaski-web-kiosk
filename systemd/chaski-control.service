[Unit]
Description=CHASKI Web Kiosk LAN management
After=network.target
Before=chaski-player.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=chaski
Group=chaski
Environment=HOME=/var/lib/chaski-player
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/chaski-player/app
RuntimeDirectory=chaski-player
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m chaski_player.control
Restart=always
RestartSec=3
TimeoutStopSec=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chaski-player/config /opt/chaski-player/media /run/chaski-player
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
