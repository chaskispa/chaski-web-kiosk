[Unit]
Description=CHASKI Web Kiosk LAN management
After=network.target
Before=chaski-web-kiosk.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=chaski
Group=chaski
Environment=HOME=/var/lib/chaski-web-kiosk
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/chaski-web-kiosk/app
RuntimeDirectory=chaski-web-kiosk
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m chaski_web_kiosk.control
Restart=always
RestartSec=3
TimeoutStopSec=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chaski-web-kiosk/config /opt/chaski-web-kiosk/media /run/chaski-web-kiosk
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
