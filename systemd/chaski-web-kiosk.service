[Unit]
Description=CHASKI Web Kiosk playback supervisor
After=chaski-web-kiosk-display.service chaski-web-kiosk-control.service
Wants=chaski-web-kiosk-display.service chaski-web-kiosk-control.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=chaski
Group=chaski
Environment=HOME=/var/lib/chaski-web-kiosk
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/chaski-xdg
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/chaski-web-kiosk/app
RuntimeDirectory=chaski-web-kiosk
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m chaski_web_kiosk.daemon
Restart=always
RestartSec=3
WatchdogSec=30
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chaski-web-kiosk/config /opt/chaski-web-kiosk/media /var/lib/chaski-web-kiosk /run/chaski-web-kiosk
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical.target
