[Unit]
Description=CHASKI Web Kiosk playback supervisor
After=chaski-display.service chaski-control.service
Wants=chaski-display.service chaski-control.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=chaski
Group=chaski
Environment=HOME=/var/lib/chaski-player
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/chaski-xdg
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/chaski-player/app
RuntimeDirectory=chaski-player
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m chaski_player.daemon
Restart=always
RestartSec=3
WatchdogSec=30
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chaski-player/config /opt/chaski-player/media /var/lib/chaski-player /run/chaski-player
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical.target
