#!/bin/sh
set -eu

repo="/opt/chaski-player/source"
if [ ! -d "$repo/.git" ]; then
    echo "Automatic update is unavailable: $repo is not a Git checkout." >&2
    echo "Update from your repository checkout with: sudo ./install.sh" >&2
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo." >&2
    exit 1
fi

git -C "$repo" pull --ff-only
exec "$repo/install.sh"
